    },
    {
      "id": "change-one",
      "type": "text",
      "x": 824,
      "y": 250,
      "width": 665.6,
      "height": 140,
      "angle": 0,
      "strokeColor": "#263936",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 7,
      "version": 1,
      "versionNonce": 1007,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "01 / Replace the permanent split with Browse → Read.\nObserved: staging stays beside list and reader, even below.\nAnchor: gpui-poc/src/main.rs:2090–2142.\nProposal: opening one message enters full-width reading;\nBack restores list position, expansion and checked set.\nWhy: the HTML gets the window, not leftover pane width.\nHypothesis: fewer spatial distractions during close reading.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "01 / Replace the permanent split with Browse → Read.\nObserved: staging stays beside list and reader, even below.\nAnchor: gpui-poc/src/main.rs:2090–2142.\nProposal: opening one message enters full-width reading;\nBack restores list position, expansion and checked set.\nWhy: the HTML gets the window, not leftover pane width.\nHypothesis: fewer spatial distractions during close reading.",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "change-two",
      "type": "text",
      "x": 1590,
      "y": 250,
      "width": 707.2,
      "height": 140,
      "angle": 0,
      "strokeColor": "#263936",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 8,
      "version": 1,
      "versionNonce": 1008,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "02 / Make metadata disclosure earn its height.\nObserved: labels, date, images and status stack above HTML.\nAnchor: gpui-poc/src/reader.rs:563–640.\nProposal: subject + one identity/state line; Details / images\nopens full address, labels, date and the per-message toggle.\nKeep load/error notices visible; long subjects may expand.\nWhy: less repeated chrome, more room for the actual argument.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "02 / Make metadata disclosure earn its height.\nObserved: labels, date, images and status stack above HTML.\nAnchor: gpui-poc/src/reader.rs:563–640.\nProposal: subject + one identity/state line; Details / images\nopens full address, labels, date and the per-message toggle.\nKeep load/error notices visible; long subjects may expand.\nWhy: less repeated chrome, more room for the actual argument.",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "change-three",
      "type": "text",
      "x": 824,
      "y": 413,
      "width": 696.8,
      "height": 140,
      "angle": 0,
      "strokeColor": "#263936",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 9,
      "version": 1,
      "versionNonce": 1009,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "03 / Collapse staging, not responsibility.\nObserved: Apply lives in bins; footer has pane icons/count.\nAnchor: gpui-poc/src/main.rs:1660–1690,2143–2150.\nProposal: persistent Pending N + Review & Apply in every mode.\nReview replaces reading, rather than squeezing it or covering it.\nBack returns to the same message and body scroll position.\nWhy: review remains discoverable without a permanent sidebar.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "03 / Collapse staging, not responsibility.\nObserved: Apply lives in bins; footer has pane icons/count.\nAnchor: gpui-poc/src/main.rs:1660–1690,2143–2150.\nProposal: persistent Pending N + Review & Apply in every mode.\nReview replaces reading, rather than squeezing it or covering it.\nBack returns to the same message and body scroll position.\nWhy: review remains discoverable without a permanent sidebar.",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "change-four",
      "type": "text",
      "x": 1590,
      "y": 413,
      "width": 696.8,
      "height": 140,
      "angle": 0,
      "strokeColor": "#263936",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 10,
      "version": 1,
      "versionNonce": 1010,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "04 / Give reading actions a stable, singular scope.\nObserved: checked actions share a wrapping toolbar with Auto-apply.\nAnchor: main.rs:1939–2076; README / Auto-apply and read status.\nProposal: Stage Archive / Trash this 1; batch controls only in Browse.\nRemove Auto-apply in this candidate: Archive/Trash always stage.\nReason: one predictable write boundary; imported ON needs a notice.\nRead/unread remains explicitly “now” and writes immediately.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "04 / Give reading actions a stable, singular scope.\nObserved: checked actions share a wrapping toolbar with Auto-apply.\nAnchor: main.rs:1939–2076; README / Auto-apply and read status.\nProposal: Stage Archive / Trash this 1; batch controls only in Browse.\nRemove Auto-apply in this candidate: Archive/Trash always stage.\nReason: one predictable write boundary; imported ON needs a notice.\nRead/unread remains explicitly “now” and writes immediately.",
      "lineHeight": 1.25,
      "autoResize": true
    },
