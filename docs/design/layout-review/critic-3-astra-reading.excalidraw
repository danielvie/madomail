    {
      "id": "interaction-flow",
      "type": "text",
      "x": 1224,
      "y": 754,
      "width": 1064.7,
      "height": 247.5,
      "angle": 0,
      "strokeColor": "#263936",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 35,
      "version": 1,
      "versionNonce": 1035,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Browse retains sender groups, filter, Refresh, Rules and Run query, without a staging pane.\nClick / Enter on one message enters Read. Group activation only expands the group.\nCheckbox click / Space only checks. The four checked messages remain a separate batch.\nBack restores the list, expansion, focus and checks; filtering still clears checks.\n\nStage Archive this 1 changes only Nora's mark: Pending 12 → 13. Unread stays unchanged.\nStay on this body at the same scroll offset; show “Staged Archive · Put back this 1”.\nDo not auto-advance. Put back cancels only that unsubmitted mark, not Gmail changes.\nReview & Apply opens review without writing. Apply there names Archive 11 / Trash 2.\nIt applies all pending marks, not the preview or four checked messages.\nRun query always stages rule matches; existing pending marks still require Apply.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Browse retains sender groups, filter, Refresh, Rules and Run query, without a staging pane.\nClick / Enter on one message enters Read. Group activation only expands the group.\nCheckbox click / Space only checks. The four checked messages remain a separate batch.\nBack restores the list, expansion, focus and checks; filtering still clears checks.\n\nStage Archive this 1 changes only Nora's mark: Pending 12 → 13. Unread stays unchanged.\nStay on this body at the same scroll offset; show “Staged Archive · Put back this 1”.\nDo not auto-advance. Put back cancels only that unsubmitted mark, not Gmail changes.\nReview & Apply opens review without writing. Apply there names Archive 11 / Trash 2.\nIt applies all pending marks, not the preview or four checked messages.\nRun query always stages rule matches; existing pending marks still require Apply.",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "interaction-keys-privacy",
      "type": "text",
      "x": 1224,
      "y": 1025,
      "width": 1076.4,
      "height": 225,
      "angle": 0,
      "strokeColor": "#263936",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 36,
      "version": 1,
      "versionNonce": 1036,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Keyboard proposal: Tab reaches every labeled control; Enter / Space activates it.\nEscape closes Details / More first; from body it focuses Back; Back returns to Browse.\nCtrl+Enter outside text inputs opens review, rather than writing from the reader.\nIn Review, focus the named Apply button and press Enter. No new one-key write shortcut.\n\nMore contains “Mark read now” / “Mark unread now” and “Sender rule…”, scoped explicitly.\nRead status writes immediately; only confirmed labels update. Unknown read status needs Refresh.\nDetails shows full address/labels/date, “Images allowed” and “Block images”. Default unchanged:\nremote images are allowed per message; blocking cannot undo requests already sent.\nHTML remains sanitized, body scrolls independently, and links open externally.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Keyboard proposal: Tab reaches every labeled control; Enter / Space activates it.\nEscape closes Details / More first; from body it focuses Back; Back returns to Browse.\nCtrl+Enter outside text inputs opens review, rather than writing from the reader.\nIn Review, focus the named Apply button and press Enter. No new one-key write shortcut.\n\nMore contains “Mark read now” / “Mark unread now” and “Sender rule…”, scoped explicitly.\nRead status writes immediately; only confirmed labels update. Unknown read status needs Refresh.\nDetails shows full address/labels/date, “Images allowed” and “Block images”. Default unchanged:\nremote images are allowed per message; blocking cannot undo requests already sent.\nHTML remains sanitized, body scrolls independently, and links open externally.",
      "lineHeight": 1.25,
      "autoResize": true
    },
