    {
      "id": "reading-body-copy",
      "type": "text",
      "x": 100,
      "y": 970,
      "width": 959.4,
      "height": 247.5,
      "angle": 0,
      "strokeColor": "#354139",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 32,
      "version": 1,
      "versionNonce": 1032,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Hi Alex,\n\nThe east gate will stay closed through Monday. Please use the north entrance;\nthe route on last week's map is no longer safe after the overnight flooding.\n\nBefore your visit\n• Arrive after 09:30, when the inspection team has cleared the walkway.\n• Use the ramp beside the library, not the temporary stairs.\n• If the river marker reaches the red band, postpone the visit.\n\nThe revised access table and site photographs continue below.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Hi Alex,\n\nThe east gate will stay closed through Monday. Please use the north entrance;\nthe route on last week's map is no longer safe after the overnight flooding.\n\nBefore your visit\n• Arrive after 09:30, when the inspection team has cleared the walkway.\n• Use the ramp beside the library, not the temporary stairs.\n• If the river marker reaches the red band, postpone the visit.\n\nThe revised access table and site photographs continue below.",
      "lineHeight": 1.25,
      "autoResize": true
    },
