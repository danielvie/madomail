      "seed": 56,
      "version": 1,
      "versionNonce": 1056,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Recheck reads each message ID, not absence from the capped Inbox.\nRequested state found → confirmed. Not applied → explicit retry. Unavailable → stays unknown.\nArchive / Trash preserve unread. Trash is not permanent deletion.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Recheck reads each message ID, not absence from the capped Inbox.\nRequested state found → confirmed. Not applied → explicit retry. Unavailable → stays unknown.\nArchive / Trash preserve unread. Trash is not permanent deletion.",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "tradeoffs-card",
      "type": "rectangle",
      "x": 1200,
      "y": 1340,
      "width": 1140,
      "height": 330,
      "angle": 0,
      "strokeColor": "#d4c7ae",
      "backgroundColor": "#fffaf0",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
