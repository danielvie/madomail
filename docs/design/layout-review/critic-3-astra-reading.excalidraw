      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Model / persona: Astra · reading-focused interaction designer; skeptical of permanent sidebars. This is a design lens, not user research.\nScenario: carefully read long HTML at 1100 × 600, then stage one decision while unrelated batches wait. LATER candidate, not migration approval.",
      "fontSize": 24,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Model / persona: Astra · reading-focused interaction designer; skeptical of permanent sidebars. This is a design lens, not user research.\nScenario: carefully read long HTML at 1100 × 600, then stage one decision while unrelated batches wait. LATER candidate, not migration approval.",
      "lineHeight": 1.25,
      "autoResize": true
    },
