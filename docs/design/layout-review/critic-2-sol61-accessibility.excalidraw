    {
      "id": "flow-text",
      "type": "text",
      "x": 1660,
      "y": 830,
      "width": 795.6,
      "height": 742.5,
      "angle": 0,
      "strokeColor": "#172b4d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
