    {
      "id": "recovery-notes-text",
      "type": "text",
      "x": 1200,
      "y": 1860,
      "width": 1235,
      "height": 500,
      "angle": 0,
      "strokeColor": "#172b4d",
      "backgroundColor": "transparent",
