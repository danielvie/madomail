      "link": null,
      "locked": false,
      "text": "LENS / accessibility + error recovery\nKeyboard-only personal triage at 150% scaling.\nScenario: stage → hide preview accidentally →\nsubmit → receive an unknown write outcome.\nMy hypothesis: stable, named tasks reduce mode errors.\nThis is a design opinion, not observed user evidence.",
      "originalText": "LENS / accessibility + error recovery\nKeyboard-only personal triage at 150% scaling.\nScenario: stage → hide preview accidentally →\nsubmit → receive an unknown write outcome.\nMy hypothesis: stable, named tasks reduce mode errors.\nThis is a design opinion, not observed user evidence.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
