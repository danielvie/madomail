    {
      "id": "change3-text",
      "type": "text",
      "x": 1320,
      "y": 370,
      "width": 549.9,
      "height": 292.5,
      "angle": 0,
      "strokeColor": "#172b4d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
