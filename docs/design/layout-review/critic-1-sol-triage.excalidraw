    {
      "id": "contract-text",
      "type": "text",
      "x": 1138,
      "y": 143,
      "width": 492,
      "height": 295,
      "angle": 0,
      "strokeColor": "#172b35",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 107,
      "version": 1,
      "versionNonce": 207,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "NON-NEGOTIABLE STATE MODEL\nPREVIEW ≠ CHECKED ≠ UNREAD ≠ PENDING.\nOpening mail does not mark it read.\nArchive and Trash preserve unread state.\n\nPut back cancels only unsubmitted marks.\nConfirmed writes leave the local Inbox;\nfailed marks remain staged. Unknown means\nrecheck each message, never blind resubmit.\n\nRun query stages even in immediate mode;\nexisting pending marks still need Apply.\nRead/unread writes immediately.",
      "originalText": "NON-NEGOTIABLE STATE MODEL\nPREVIEW ≠ CHECKED ≠ UNREAD ≠ PENDING.\nOpening mail does not mark it read.\nArchive and Trash preserve unread state.\n\nPut back cancels only unsubmitted marks.\nConfirmed writes leave the local Inbox;\nfailed marks remain staged. Unknown means\nrecheck each message, never blind resubmit.\n\nRun query stages even in immediate mode;\nexisting pending marks still need Apply.\nRead/unread writes immediately.",
      "fontFamily": 5,
      "fontSize": 17,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
