      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Left-click a message row: display it and open the reader.\nReading never checks a message or clears existing checkmarks.\nOnly the checkbox gutter marks items for bulk actions.\nMessage checkbox: toggle that message, leave the reader alone.\nGroup checkbox: toggle its messages; mixed state shows a dash.\nMixed group click checks all; fully checked group click clears all.\nGroup body / chevron expands to expose individual messages.\nCheckboxes, chevrons and action buttons do not trigger reading.",
      "originalText": "Left-click a message row: display it and open the reader.\nReading never checks a message or clears existing checkmarks.\nOnly the checkbox gutter marks items for bulk actions.\nMessage checkbox: toggle that message, leave the reader alone.\nGroup checkbox: toggle its messages; mixed state shows a dash.\nMixed group click checks all; fully checked group click clears all.\nGroup body / chevron expands to expose individual messages.\nCheckboxes, chevrons and action buttons do not trigger reading.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
