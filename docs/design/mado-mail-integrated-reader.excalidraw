      "roundness": null,
      "seed": 1948074,
      "version": 1,
      "versionNonce": 878466,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "The current HTML reader uses a native WebView2 child in a separate window.\nEmbedding needs verified clipping, bounds, resize and keyboard focus.\nCollapse and Rules view must hide the native child, not just its GPUI frame.\nRestore the reader without refetching or losing scroll where possible.\nKeep remote images blocked and guard against stale asynchronous loads.",
