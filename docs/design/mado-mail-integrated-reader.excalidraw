      "versionNonce": 857040,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Drag either divider to resize reader or staging.\nRemember each width independently across launches.\nHiding a pane never saves a zero width.\nRestore the last width on show; list takes the rest.\nClamp to usable sizes if the window is smaller,\nbut retain the saved preferred widths.",
      "originalText": "Drag either divider to resize reader or staging.\nRemember each width independently across launches.\nHiding a pane never saves a zero width.\nRestore the last width on show; list takes the rest.\nClamp to usable sizes if the window is smaller,\nbut retain the saved preferred widths.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
