    },
    {
      "id": "integrated-246",
      "type": "text",
      "x": 1060,
      "y": 2280,
      "width": 820.8,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#667588",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0.5,
