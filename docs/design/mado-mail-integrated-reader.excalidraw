      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Row A/D acts only on that row, never checked mail\nelsewhere. A group row acts on its own messages.\nToolbar Archive N / Delete N acts on checked mail.\nDisable bulk actions when nothing is checked.\nAlways A/D stays sender-wide and saves a rule.\nChecking alone never stages or applies an action.",
      "originalText": "Row A/D acts only on that row, never checked mail\nelsewhere. A group row acts on its own messages.\nToolbar Archive N / Delete N acts on checked mail.\nDisable bulk actions when nothing is checked.\nAlways A/D stays sender-wide and saves a rule.\nChecking alone never stages or applies an action.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
