      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Displayed: blue row, blue stripe, Reading label.\nChecked: green checkbox and green gutter.\nChecking the displayed message keeps its blue row\nand adds the checkbox state; it does not reopen.\nA partially checked group uses a dash.\nKeyboard focus is a separate thin outline.",
      "originalText": "Displayed: blue row, blue stripe, Reading label.\nChecked: green checkbox and green gutter.\nChecking the displayed message keeps its blue row\nand adds the checkbox state; it does not reopen.\nA partially checked group uses a dash.\nKeyboard focus is a separate thin outline.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
